<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Secuencia automática para Documentos de Préstamo Cíes y Ons -->
    <record id="seq_loan_document" model="ir.sequence">
        <field name="name">Documento de Préstamo</field>
        <field name="code">project.loan.document</field>
        <field name="prefix">PRES/</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
